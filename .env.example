# ===================================================================
# Lumiere Media Server — Environment Configuration
# ===================================================================

# Web & API Port
PORT=3000

# TMDB (The Movie Database) API Configuration
# Get your free API Read Access Token at: https://www.themoviedb.org/settings/api
TMDB_TOKEN=your_tmdb_api_read_access_token_here

# TMDB Proxy (optional, required if TMDB is blocked in your region)
# Example: socks5h://user:password@host:port or http://user:password@host:port
TMDB_PROXY_URL=

# PostgreSQL Database Settings
DB_HOST=postgres
DB_PORT=5432
DB_USER=lumiere
DB_PASS=lumiere123
DB_NAME=lumiere

# TorrServer URL (internal container name or external URL)
TORRSERVER_URL=http://torrserver:8090

# JacRed Torrent Indexer URL (online scraper or local instance)
JACRED_URL=http://ns3bg91xvuqfvq9h.cfhttp.top

# Security & Authentication (Change these secrets in production!)
JWT_SECRET=change_me_to_a_random_secure_jwt_secret_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# User Registration Settings
# Set to 'true' to require an invite code for new user registration
INVITE_REGISTRATION=true
ADMIN_SECRET=change_me_to_a_random_admin_secret
